#!/usr/bin/env bash
# Workspace helper for the restored CachyOS layout:
#   ROG (left, 165Hz):  Gaming + 1 3 5 7 9
#   AOC (right, 144Hz): 2 4 6 8 10
#
# Hyprland owns the placement/persistence rules in
# ~/.config/hypr/workspace-layout.lua. This script only switches/moves and
# pokes the shell so the glitch transition plays.
set -euo pipefail

SOCK="${XDG_RUNTIME_DIR:-/tmp}/astal/cyberpunk.sock"

target() {
    case "${1,,}" in
        g|game|gaming|name:gaming) printf '%s' "name:Gaming" ;;
        *) printf '%s' "$1" ;;
    esac
}

lua_ws() {
    if [[ "$1" =~ ^-?[0-9]+$ ]]; then
        printf '%s' "$1"
    else
        printf "'%s'" "${1//\'/\\\'}"
    fi
}

tell_shell() {
    # $1 = target workspace
    # $2 = monitor key "x,y" for the monitor that should glitch
    if [[ -n "${2:-}" ]]; then
        printf 'ws-go %s %s\n' "$1" "$2" | socat - UNIX-CONNECT:"$SOCK" >/dev/null 2>&1 || true
    else
        printf 'ws-go %s\n' "$1" | socat - UNIX-CONNECT:"$SOCK" >/dev/null 2>&1 || true
    fi
}

# Find the monitor that owns this workspace in the restored G/odd-even layout.
monitor_for_workspace() {
    local ws
    ws="$(target "${1:?workspace required}")"
    if [[ "$ws" == "name:Gaming" ]]; then
        hyprctl monitors -j 2>/dev/null | jq -r '.[] | select((.description|test("ROG|PG279"; "i")) or .x==0) | "\(.x),\(.y)"' | head -n1
        return
    fi
    if [[ "$ws" =~ ^-?[0-9]+$ ]]; then
        if (( ws % 2 == 0 )); then
            hyprctl monitors -j 2>/dev/null | jq -r '.[] | select((.description|test("AOC|Q27G2"; "i")) or .x>0) | "\(.x),\(.y)"' | head -n1
        else
            hyprctl monitors -j 2>/dev/null | jq -r '.[] | select((.description|test("ROG|PG279"; "i")) or .x==0) | "\(.x),\(.y)"' | head -n1
        fi
        return
    fi
}

go_workspace() {
    local ws mk
    ws="$(target "${1:?workspace required}")"
    mk="$(monitor_for_workspace "$ws" 2>/dev/null || true)"
    hyprctl dispatch "hl.dsp.focus({ workspace = $(lua_ws "$ws") })" >/dev/null 2>&1 || true
    tell_shell "$ws" "$mk"
}

move_window() {
    local ws
    ws="$(target "${1:?workspace required}")"
    hyprctl dispatch "hl.dsp.window.move({ workspace = $(lua_ws "$ws") })" >/dev/null 2>&1 || true
}

pin_workspaces() {
    # Placement now lives in Hyprland workspace rules, so there is nothing to
    # pin here. The old 10-workspaces-per-monitor pinning would fight them.
    :
}

cmd="${1:-go}"
case "$cmd" in
    go) shift; go_workspace "${1:?workspace required}" ;;
    move) shift; move_window "${1:?workspace required}" ;;
    pin|normalize) exit 0 ;;
    [0-9]*|g|G|game|gaming) go_workspace "$cmd" ;;
    *) echo "usage: $0 {go|move|pin|normalize} [workspace]" >&2; exit 2 ;;
esac
